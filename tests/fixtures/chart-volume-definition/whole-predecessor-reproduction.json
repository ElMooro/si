{
  "scope": "Complete invented chart frames evaluated with exact extracted functions from the current complete chart engine. No provider/application data requests, no source mutation.",
  "source": {
    "path": "jh-chart-engine.js",
    "bytes": 371604,
    "sha256": "8d90ef2119f799924f664c2c60adb4735b34e81abd9f6bfa7269f7c196c8a334"
  },
  "functions": {
    "rvolAt": "function rvolAt(d, i, n){\n    n=n||20;\n    var look=Math.min(n, i), avg=0, j;\n    if(!look) return 1;\n    for(j=i-look;j<i;j++) avg+=d[j].volume||0;\n    avg/=look;\n    return avg?(d[i].volume||0)/avg:1;\n  }",
    "volCandlePaint": "function volCandlePaint(b, r){\n    var up=b.close>=b.open, hot=r>=2.5, busy=r>=1.6, thin=r<0.65, body, edge;\n    if(up){\n      if(hot){ body=\"#00c896\"; edge=\"#14e0aa\"; }\n      else if(busy){ body=\"#0b9e86\"; edge=\"#089981\"; }\n      else if(thin){ body=\"rgba(8,153,129,0.32)\"; edge=\"rgba(8,153,129,0.62)\"; }\n      else { body=UP; edge=UP; }\n    } else {\n      if(hot){ body=\"#ff2d44\"; edge=\"#ff5a6a\"; }\n      else if(busy){ body=\"#e04452\"; edge=\"#f23645\"; }\n      else if(thin){ body=\"rgba(242,54,69,0.32)\"; edge=\"rgba(242,54,69,0.62)\"; }\n      else { body=DN; edge=DN; }\n    }\n    return {time:b.time,open:b.open,high:b.high,low:b.low,close:b.close, color:body, borderColor:edge, wickColor:edge};\n  }",
    "rvolSeries": "function rvolSeries(d,n){ n=n||20; var o=[],s=0,i; for(i=0;i<d.length;i++){ s+=d[i].volume; if(i>=n) s-=d[i-n].volume; if(i>=n-1){ var avg=s/n; o.push({time:d[i].time,value:avg?d[i].volume/avg:1}); } } return o; }",
    "obv": "function obv(d){ var o=[],v=0,i; for(i=0;i<d.length;i++){ if(i) v+= d[i].close>=d[i-1].close? d[i].volume : -d[i].volume; o.push({time:d[i].time,value:v}); } return o; }"
  },
