        {
          "before": "  function cq(doc, sym) {",
          "after": "  function cqDefinition(sym) {\n    if (String(sym || '').replace(/^CQ:/i, '').toLowerCase() !== 'btc_fees_total') return null;\n    return {\n      status: 'definition_conflict', display_name: 'BTC fees \u00b7 definition conflict',\n      reason: 'Legacy total-fee identifier is configured to fees_block_mean. Historical field lineage is unverified; do not interpret these values as total fees.',\n      reviewed_at: '2026-10-05', configured_path: '/btc/network-data/fees',\n      configured_field: 'fees_block_mean', conflicting_label: 'Total Fees', conflicting_unit: 'BTC/d',\n      reviewed_spec_sha256: '058b56994f1b8ee13c4219273e355afeed43489ceefd38d1c1816d6df7275aa9',\n      field_documentation: 'https://userguide.cryptoquant.com/api/btc-network-data',\n      historical_field_verified: false, total_fees_qualified: false,\n      resolution: 'Requires retained original responses and independently checked field lineage; a label or config edit alone cannot repair historical measurements.'\n    };\n  }\n  function cq(doc, sym) {"
        },
        {
          "before": "    var twins = exactKeys(doc.twins, key);",
          "after": "    var review = cqDefinition(key);\n    if (review) {\n      result.evidence.definition_review = review;\n      result.evidence.reported_unit = result.evidence.unit;\n      result.evidence.unit = null;\n      result.evidence.measurement_definition_verified = false;\n      result.src = review.display_name + ' \u00b7 ' + review.reason + ' \u00b7 ' + result.d.length + ' received scalar observations \u00b7 unit unverified';\n    }\n    var twins = exactKeys(doc.twins, key);"
        },
        {
          "before": "cq: cq, ciss: ciss",
          "after": "cq: cq, cqDefinition: cqDefinition, ciss: ciss"
        }
      ],
      "after_sha256": "c7d1e456b9fab8a11bd7e36fd7cc384dff62fc87b48ca92325062596599beb57"
    },
