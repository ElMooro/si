{
  "name": "justhodl-oecd-cli",
  "function_name": "justhodl-oecd-cli",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory_mb": 768,
  "timeout": 300,
  "timeout_s": 300,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "environment_keys": [
    "S3_BUCKET"
  ],
  "layers": [],
  "reserved_concurrency": 1,
  "function_url": {
    "auth_type": "NONE",
    "cors": {
      "AllowCredentials": false,
      "AllowHeaders": [
        "content-type"
      ],
      "AllowMethods": [
        "*"
      ],
      "AllowOrigins": [
        "*"
      ],
      "MaxAge": 86400
    }
  },
  "eventbridge_rules": [
    "justhodl-oecd-cli-weekly"
  ],
  "description": "OECD CLI v2.0.0: amplitude-adjusted Composite Leading Indicators from the OECD's own SDMX pull (17 economies + OECD/G7/euro-area aggregates) via the cycle feature store; FRED mirror stopped Jan 2024. data/oecd-cli.json + v3 composite per country.",
  "memory": 768
}