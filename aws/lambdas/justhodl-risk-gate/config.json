{
  "function_name": "justhodl-risk-gate",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 600,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Original-source risk research: 25 FRED identities, matched-date differences, retained ECB/fleet context and reproducible evidence; no unqualified portfolio sizing.",
  "environment": {},
  "inherit_env": [
    {
      "from_function": "justhodl-signal-backtest",
      "keys": [
        "FRED_KEY",
        "FMP_KEY"
      ]
    }
  ],
  "release_validation": {
    "schema_version": "risk-gate.v3"
  }
}
