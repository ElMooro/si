{
  "runtime": "python3.12",
  "memory": 512,
  "timeout": 180,
  "handler": "lambda_function.lambda_handler",
  "role_arn": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Recorded Gold / Equity ETF observations with original-source replay and exact-date ratios; no unqualified forecast, portfolio sizing or notifications.",
  "inherit_env": true,
  "env": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-gold-equity-rotation-daily",
    "cron": "cron(45 22 * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Gold-equity rotation regime detector daily 22:45 UTC"
  },
  "schedule": {
    "name": "justhodl-gold-equity-rotation-sched",
    "expression": "cron(45 20 ? * MON-FRI *)",
    "description": "Flow-fleet revival (ops 2720)"
  }
}
