{
  "function_name": "justhodl-activity-nowcast",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 256,
  "timeout": 90,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "High-frequency activity measurements. Monthly macro comparison abstains without a qualified common scale or regime; source dates and existing component calculations are retained.",
  "environment": {},
  "schedule": {
    "rule_name": "activity-nowcast-daily",
    "cron": "cron(30 12 * * ? *)",
    "description": "Real-Time Activity Nowcast \u2014 daily 12:30 UTC"
  }
}
