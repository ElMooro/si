{
  "function_name": "justhodl-tax-plan",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 512,
  "timeout": 30,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Owner tax-aware portfolio scenarios: holding-period classification, tax-if-sold estimates, after-tax returns, harvest candidates, asset location and annual federal/state/NIIT estimates.",
  "env": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "function_url": {
    "auth_type": "NONE",
    "cors": {
      "AllowOrigins": [
        "*"
      ],
      "AllowMethods": [
        "GET",
        "POST"
      ],
      "AllowHeaders": [
        "content-type"
      ],
      "MaxAge": 300
    }
  },
  "schedule": {
    "rule_name": "tax-plan-daily",
    "cron": "cron(45 11 ? * * *)",
    "description": "Daily 11:45 UTC — refresh default-profile tax plan snapshot"
  }
}
