{
  "name": "justhodl-liquidity-agent",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory_mb": 512,
  "timeout_s": 300,
  "package_type": "Zip",
  "role_arn_tail": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Original-source liquidity measurements with immutable replay; no investment authority",
  "env_keys": [
    "FRED_API_KEY",
    "S3_BUCKET"
  ],
  "layers": [],
  "architectures": [
    "arm64"
  ],
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-liquidity-agent-daily",
    "group_name": "default",
    "cron": "cron(30 12 * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Daily source-qualified liquidity measurements from retained originals; no provider requests",
    "retry_policy": {
      "MaximumRetryAttempts": 2,
      "MaximumEventAgeInSeconds": 3600
    },
    "dead_letter_config": {
      "Arn": "arn:aws:sqs:us-east-1:857687956942:justhodl-dlq-default"
    }
  }
}
