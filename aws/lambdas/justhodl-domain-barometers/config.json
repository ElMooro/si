{
  "function_name": "justhodl-domain-barometers",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1536,
  "timeout": 600,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Macro, liquidity and risk classifiers combining domain evidence and market breadth into barometers and asset-class research signals with grading history.",
  "environment": {},
  "inherit_env": [
    {
      "from_function": "justhodl-signal-backtest",
      "keys": [
        "FRED_KEY",
        "FMP_KEY"
      ]
    }
  ]
}
