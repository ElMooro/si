{
  "function_name": "justhodl-wealth-plan",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 60,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Owner retirement scenarios using Capital Compass return assumptions, covariance and Monte Carlo paths; reports success probability, trajectory percentiles, savings needs, inflation-adjusted outcomes and sensitivity.",
  "env": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "function_url": {
    "auth_type": "NONE",
    "cors": {
      "AllowOrigins": [
        "*"
      ],
      "AllowMethods": [
        "*"
      ],
      "AllowHeaders": [
        "content-type"
      ],
      "MaxAge": 300
    }
  }
}
