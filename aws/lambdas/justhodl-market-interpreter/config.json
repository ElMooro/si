{
  "function_name": "justhodl-market-interpreter",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 180,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "layers": [
    "arn:aws:lambda:us-east-1:857687956942:layer:justhodl-core:1"
  ],
  "environment_keys": [
    "ANTHROPIC_API_KEY"
  ],
  "description": "Macro interpretation for seven rates, credit, dollar and stress contexts; native USD observations are non-voting. Writes data/interpretations/<context>.json."
}
