{
  "function_name": "justhodl-polygon-fx-regime",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 60,
  "memory": 512,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Recorded original FX quote bars with exact dated comparisons and replay",
  "environment_keys": [],
  "schedule": {
    "expression": "cron(10 13 * * ? *)",
