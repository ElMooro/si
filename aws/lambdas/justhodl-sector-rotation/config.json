{
  "function_name": "justhodl-sector-rotation",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 300,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Sector rotation and money flow across 11 SPDR sectors and 14 ratios; scores relative strength, money flow, trend, volume, regime leadership and sub-sector confirmation, with early-rotation alerts.",
  "environment": {},
  "inherit_env": [
    {
      "from_function": "justhodl-options-flow-scanner",
      "keys": [
        "POLY_KEY"
      ]
    },
    {
      "from_function": "justhodl-screener-alerts",
      "keys": [
        "TELEGRAM_TOKEN",
        "TELEGRAM_CHAT_ID"
      ]
    }
  ],
  "schedule": {
    "name": "justhodl-sector-rotation-sched",
    "expression": "cron(5 21 ? * MON-FRI *)",
    "description": "Flow-fleet revival (ops 2720)"
  }
}
