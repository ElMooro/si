{
  "function_name": "justhodl-flow-lookthrough",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 840,
  "memory": 3072,
  "description": "Source-replayed ETF holding memberships and position comparisons; no inferred purchases, sales or extra evidence votes.",
  "environment": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "schedule": {
    "name": "justhodl-flow-lookthrough-daily",
    "expression": "cron(15 23 * * ? *)",
    "description": "18:15 ET daily \u2014 after etf-flows (22:00) + capital-flow-radar (22:30)"
  },
  "tags": {
    "Project": "JustHodl",
    "Component": "flow-intelligence",
    "Tier": "lookthrough"
  }
}
