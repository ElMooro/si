{
  "function_name": "justhodl-import-sentinel",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 600,
  "memory": 1024,
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "ops 4576: import-pipeline monitor \u2014 classifies FRED/SDMX/catalog health every 10 min, auto-heals safe stalls, flips FRED full-catalog expansion on scoped COMPLETE, publishes data/import-health.json.",
  "environment": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-import-sentinel-10min",
    "group_name": "default",
    "cron": "cron(52 20 * * ? *)",
    "timezone": "UTC",
    "state": "ENABLED",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role"
  },
  "tags": {
    "Project": "JustHodl",
    "Component": "control-plane",
    "Tier": "sentinel"
  }
}