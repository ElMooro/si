{
  "function_name": "justhodl-sovereign-stress",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 600,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Sovereign systemic-stress \u2014 European sovereign spreads, CISS/SovCISS, equity+bond+unemployment stress per country \u2192 europe_stress.score_0_100. Publishes data/sovereign-stress.json daily.",
  "env": {},
  "schedule": {
    "rule_name": "sovereign-stress-daily",
    "cron": "cron(0 12 ? * * *)",
    "description": "Sovereign stress daily 12:00 UTC"
  }
}
