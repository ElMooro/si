{
  "function_name": "justhodl-tv-workbench",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 1024,
  "timeout": 300,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "TradingView mirror: every watchlist with its indicators, per-indicator brain notes, live vault values, and TV source attribution \u2014 one artifact for the tv-workbench page.",
  "environment": {},
  "inherit_env": [
    {
      "from_function": "justhodl-signal-backtest",
      "keys": [
        "FRED_KEY",
        "FMP_KEY"
      ]
    }
  ]
}