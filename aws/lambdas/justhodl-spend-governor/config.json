{
  "function_name": "justhodl-spend-governor",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 512,
  "timeout": 900,
  "architectures": ["x86_64"],
  "role": "arn:aws:iam::857687956942:role/justhodl-spend-governor-role",
  "description": "ops 6522 - monthly AWS spend cap: reads budget JustHodl-Monthly-Hard-Cap-500, brakes then freezes spend below the cap (lag + residual aware), runaway fuse, restores exactly on the 1st",
  "env": {
    "BUDGET_NAME": "JustHodl-Monthly-Hard-Cap-500",
    "STATE_BUCKET": "justhodl-ops-private-857687956942",
    "ALERT_TOPIC_ARN": "arn:aws:sns:us-east-1:857687956942:justhodl-fleet-alerts",
    "ACCOUNT_ID": "857687956942",
    "CE_INTERVAL_H": "6"
  },
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-spend-governor-tick",
    "cron": "cron(7 * * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Hourly spend-cap tick (ops 6522)",
    "input": {"action": "tick"}
  }
}
