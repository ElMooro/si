{
  "function_name": "justhodl-vintage-fred",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 900,
  "memory": 1536,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Original ALFRED periods and historical definitions with replay; conservative dated archive research",
  "environment_keys": [
    "FRED_KEY"
  ],
  "schedule": {
    "expression": "cron(0 13 * * ? *)",
    "name": "justhodl-vintage-fred-daily",
    "description": "Daily 13:00 UTC vintage capture"
  }
}
