{
  "function_name": "justhodl-implied-prob",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 512,
  "timeout": 240,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Source-defined rate, recession-model and volatility-index research with original-source replay; no Treasury-yield proxy for meeting probabilities or unqualified return forecasts.",
  "schedule": {
    "rule_name": "justhodl-implied-prob-cadence",
    "cron": "cron(25 22 ? * MON-FRI *)",
    "description": "Existing weekday research cadence, 22:25 UTC"
  }
}
