{
  "function_name": "justhodl-gsi-calibrator",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 512,
  "timeout": 180,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Public Global Stress research and qualification status; original-source comparisons, no learned sizing weights or notifications.",
  "environment": {
    "TELEGRAM_CHAT_ID": "8678089260"
  },
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-gsi-calibrator-weekly",
    "cron": "cron(0 9 ? * SUN *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "GSI calibrator weekly recalibration - Sundays 09:00 UTC."
  }
}
