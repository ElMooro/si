{
  "function_name": "justhodl-equity-research",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 300,
  "memory": 1024,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Company research data with deterministic abstention. No paid AI calls or unqualified Share Flows flags. Existing runtime and URL configuration preserved.",
  "environment_keys": [
    "FMP_KEY"
  ],
  "inherit_env": false,
  "function_url": {
    "enabled": true,
    "auth_type": "NONE",
    "cors_origins": [
      "*"
    ]
  }
}
