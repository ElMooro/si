{
  "schema_version": "1.0.0",
  "criticality_policy": {
    "fail_closed": "Only sources marked critical force DATA_HOLD when missing, invalid, or stale. Noncritical lenses become unavailable and cannot fabricate neutral evidence.",
    "critical_sources": ["risk_gate", "crisis", "bond_warroom", "eurodollar_stress", "credit_composite"],
    "settlement_fails": "Weekly NY Fed observation; noncritical for availability, but a fresh severe observation tightens or vetoes capital. Freshness is based on treasury.as_of, never daily generated_at."
  },
  "inputs": [
    {"id":"risk_gate","domain":"master","artifact":"data/risk-gate.json","producer":"justhodl-risk-gate","critical":true,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["posture","composite","sizing_multiplier"],"types":{"posture":"string","composite":"number","sizing_multiplier":"number"},"allowed":{"posture":["RISK_ON","NEUTRAL","RISK_OFF","SEVERE"]},"ranges":{"composite":[-10,10],"sizing_multiplier":[0,1]}}},
    {"id":"crisis","domain":"black_swan","artifact":"data/crisis-composite.json","producer":"justhodl-crisis-composite","critical":true,"max_age_hours":8,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["defcon_level","components_available","components"],"types":{"defcon_level":"number","components_available":"number","components":"list"},"item_types":{"components":"dict"},"ranges":{"defcon_level":[1,5],"components_available":[0,10000]}}},
    {"id":"bond_warroom","domain":"rates","artifact":"data/bond-warroom.json","producer":"justhodl-bond-warroom","critical":true,"max_age_hours":84,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["heartbeat","equity_risk","eurodollar_shortage","panels"],"types":{"heartbeat":"dict","equity_risk":"dict","eurodollar_shortage":"dict","panels":"dict"}}},
    {"id":"dollar_radar","domain":"dollar","artifact":"data/dollar-radar.json","producer":"justhodl-dollar-radar","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["dollar_pressure"],"types":{"dollar_pressure":"number"},"ranges":{"dollar_pressure":[0,100]}}},
    {"id":"euro_fragmentation","domain":"sovereign","artifact":"data/euro-fragmentation.json","producer":"justhodl-euro-fragmentation","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["fragmentation","countries"],"types":{"fragmentation":"dict","countries":"dict"}}},
    {"id":"auction_desk","domain":"treasury","artifact":"data/auction-desk.json","producer":"justhodl-auction-desk","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["today"],"types":{"today":"dict"}}},
    {"id":"eurodollar_stress","domain":"funding","artifact":"data/eurodollar-stress.json","producer":"justhodl-eurodollar-stress","critical":true,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["composite_score"],"types":{"composite_score":"number"},"ranges":{"composite_score":[0,100]}}},
    {"id":"credit_composite","domain":"credit","artifact":"data/credit-composite.json","producer":"justhodl-credit-composite","critical":true,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_any":["composite","composite_score"],"types":{"composite":"number","composite_score":"number"},"ranges":{"composite":[0,100],"composite_score":[0,100]}}},
    {"id":"fifx_vol","domain":"volatility","artifact":"data/fifx-vol.json","producer":"justhodl-fifx-vol-migration","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["legs","migration"],"types":{"legs":"dict","migration":"dict"}}},
    {"id":"global_liquidity","domain":"liquidity","artifact":"data/global-liquidity.json","producer":"justhodl-global-liquidity","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["global_liquidity_index","fed_net_liquidity"],"types":{"global_liquidity_index":"dict","fed_net_liquidity":"dict"}}},
    {"id":"cycle_clock","domain":"cycle","artifact":"data/cycle-clock.json","producer":"justhodl-cycle-clock","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_all":["synthesis","cycle"],"types":{"synthesis":"dict","cycle":"dict"}}},
    {"id":"fx_intelligence","domain":"fx","artifact":"data/fx-intelligence.json","producer":"justhodl-fx-intelligence","critical":false,"max_age_hours":30,"timestamp_paths":["as_of","generated_at"],"contract":{"required_any":["usd_regime","risk_state"],"types":{"usd_regime":"dict","risk_state":"string"}}},
    {"id":"settlement_fails","domain":"plumbing","artifact":"data/settlement-fails.json","producer":"justhodl-settlement-fails","critical":false,"max_age_hours":240,"timestamp_paths":["treasury.as_of"],"freshness_basis":"weekly_observation","contract":{"required_all":["treasury"],"types":{"treasury":"dict"}}}
  ]
}
