{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDashboardBrainReadsAndWrites",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::justhodl-dashboard-live/brain",
        "arn:aws:s3:::justhodl-dashboard-live/brain/*",
        "arn:aws:s3:::justhodl-dashboard-live/data/brain.json",
        "arn:aws:s3:::justhodl-dashboard-live/data/brain/*",
        "arn:aws:s3:::justhodl-dashboard-live/data/brain-history.json",
        "arn:aws:s3:::justhodl-dashboard-live/data/brain-history/*"
      ]
    },
    {
      "Sid": "UseAiDataKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:857687956942:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/justhodl-ai-prod"
        }
      }
    },
    {
      "Sid": "PriceAndCostRead",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "pricing:GetProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerMetricsRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadEndpointLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:857687956942:log-group:/aws/sagemaker/Endpoints/jh-ai-*:*"
    },
    {
      "Sid": "ReadOnlyApprovedParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:857687956942:parameter/justhodl/api-admin/token",
        "arn:aws:ssm:us-east-1:857687956942:parameter/justhodl/llm/*"
      ]
    }
  ]
}
