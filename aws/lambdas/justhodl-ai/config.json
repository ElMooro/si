{
  "function_name": "justhodl-ai",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 3008,
  "timeout": 900,
  "ephemeral_storage": 2048,
  "architectures": [
    "x86_64"
  ],
  "role": "arn:aws:iam::857687956942:role/justhodl-ai-lambda-prod",
  "description": "AI v1: the front window to Amazon SageMaker -- live inventory, JumpStart financial-model catalog (RoBERTa-SEC transfer learning), Brain-derived datasets, train/deploy/infer control plane with hard cost guards; read model data/ai.json",
  "env": {
    "AI_ENVIRONMENT": "production",
    "AI_PRIVATE_BUCKET": "justhodl-ai-857687956942",
    "AI_PUBLIC_BUCKET": "justhodl-dashboard-live",
    "AI_BRAIN_SOURCE_BUCKET": "justhodl-ai-brain-857687956942-us-east-1",
    "AI_EVENT_BUS": "justhodl-ai-prod",
    "SIGNAL_FEATURE_GROUP": "justhodl-ai-signal-prod",
    "PREDICTION_FEATURE_GROUP": "justhodl-ai-prediction-prod",
    "PREDICTION_LEDGER_TABLE": "justhodl-ai-prediction-ledger-prod",
    "PREDICTION_LEDGER_ARCHIVE_BUCKET": "justhodl-ai-prediction-ledger-857687956942-us-east-1",
    "MODEL_PACKAGE_GROUP": "justhodl-ai-prod",
    "MLFLOW_TRACKING_SERVER_NAME": "justhodl-ai-prod",
    "MLFLOW_TRACKING_SERVER_ARN": "arn:aws:sagemaker:us-east-1:857687956942:mlflow-tracking-server/justhodl-ai-prod",
    "MLFLOW_EXPERIMENT_NAME": "justhodl-ai-prod",
    "TRAINING_INPUT_BUCKET": "justhodl-ai-training-inputs-857687956942-us-east-1",
    "AI_GOVERNANCE_OWNER": "JustHodl",
    "SAGEMAKER_ROLE_ARN": "arn:aws:iam::857687956942:role/justhodl-ai-sagemaker-prod"
  },
  "function_url": {
    "enabled": true,
    "cors_origins": [
      "https://justhodl.ai",
      "https://www.justhodl.ai"
    ]
  },
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-ai-inventory",
    "cron": "cron(7 * * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "AI hourly 07 past: SageMaker inventory + cost guard (idle endpoint TTL, budget) + continuation of pending Brain embedding passes; never self-invokes"
  }
}
