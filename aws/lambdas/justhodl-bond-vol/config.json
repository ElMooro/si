{
  "runtime": "python3.12",
  "memory": 1024,
  "timeout": 180,
  "handler": "lambda_function.lambda_handler",
  "role_arn": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Complete original-source bond volatility research; dated rates/spread statistics and separate identity-checked MOVE quote.",
  "env": {
    "S3_BUCKET": "justhodl-dashboard-live"
  },
  "preserved_schedule_reference": {
    "schedule_name": "justhodl-bond-vol-hourly",
    "cron": "cron(15 * * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Bond Vol Composite hourly :15"
  },
  "schedule": "cron(15 18 * * ? *)"
}
