{
  "function_name": "justhodl-student-rsi",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "role": "arn:aws:iam::857687956942:role/justhodl-student-rsi-role",
  "timeout": 120,
  "memory": 512,
  "update_role": true,
  "update_handler": true,
  "description": "JustHodl Gear A: external evidence, bounded coding search, independent grader, immutable salon, state healing. No training or resource acquisition.",
  "env": {"FACTORY_PRIVATE_BUCKET": "justhodl-ai-857687956942", "FACTORY_PUBLIC_BUCKET": "justhodl-dashboard-live"},
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-student-rsi-1m",
    "cron": "rate(1 minute)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Bounded Gear A tick; private pause control; no model training"
  }
}
