{
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "timeout": 300,
  "memory": 512,
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "US10Y 5% red-flag sentinel: level/velocity danger ladder, SPX episode study, tier-cross Telegram -> data/us10y-sentinel.json (ops 3286).",
  "inherit_env": [
    {
      "from_function": "justhodl-confluence-meta",
      "keys": [
        "FRED_KEY",
        "FRED_API_KEY"
      ]
    }
  ],
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-us10y-sentinel-5x",
    "cron": "cron(20 0,6,12,16,20 * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role"
  }
}
