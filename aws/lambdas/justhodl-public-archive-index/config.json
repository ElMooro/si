{
  "function_name": "justhodl-public-archive-index",
  "region": "us-east-1",
  "runtime": "python3.12",
  "handler": "lambda_function.lambda_handler",
  "memory": 512,
  "timeout": 180,
  "architectures": ["x86_64"],
  "role": "arn:aws:iam::857687956942:role/lambda-execution-role",
  "description": "Metadata-only indexes of reviewed unique public archive families. No payload reads, no private families and no freshness/immutability certification.",
  "environment": {},
  "eventbridge_scheduler": {
    "schedule_name": "justhodl-public-archive-index-15min",
    "cron": "cron(0/15 * * * ? *)",
    "timezone": "UTC",
    "role_arn": "arn:aws:iam::857687956942:role/justhodl-scheduler-role",
    "description": "Refresh complete public archive metadata indexes every 15 minutes",
    "input": {}
  },
  "release_validation": {"schema_version": "public-engine-archive-index.v1", "bootstrap_if_absent": true}
}
