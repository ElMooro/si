  const pctRows = rows.filter(r=>r.yoy_pct!=null);
  const maxAbs = Math.max(...pctRows.map(r=>Math.abs(r.yoy_pct)), 1);
  const KIND = {sovciss:'SovCISS', ciss:'CISS'};
  const bar = r=>{
    const v=r.yoy_pct, up=v>=0, w=Math.min(50, Math.abs(v)/maxAbs*50);
    const col=up?'var(--red)':'var(--green)';
    return `<div class="flex items-center gap-2 py-1">
      <span class="mono text-xs" style="width:150px;color:var(--text-secondary)">${FLAG[r.name]||''} ${cap(r.name)} <span style="color:var(--text-muted)">· ${KIND[r.kind]||r.kind}</span></span>
      <div style="flex:1;position:relative;height:14px">
        <div style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--border-soft)"></div>
        <div style="position:absolute;top:2px;bottom:2px;${up?`left:50%`:`right:50%`};width:${w}%;background:${col};opacity:.85;border-radius:2px"></div>
      </div>
      <span class="mono text-xs" style="width:120px;text-align:right;color:${col}">${v>0?'+':''}${fmt(v,1)}% <span style="color:var(--text-muted)">${r.level_12m!=null?fmt(r.level_12m,3)+'→'+fmt(r.level,3):''}</span></span>
    </div>`;
  };
  const proxy = rows.filter(r=>r.kind==='wgb_yield');
  const maxBp = Math.max(...proxy.map(r=>Math.abs(r.yoy_bp||0)), 1);
  const pbar = r=>{
    if (r.yoy_bp==null) return `<div class="flex items-center gap-2 py-1"><span class="mono text-xs" style="width:150px;color:var(--text-secondary)">${FLAG[r.name]||''} ${cap(r.name)}</span><span class="text-[10px] text-[var(--text-muted)]">${r.note||'accruing'}</span></div>`;
    const v=r.yoy_bp, up=v>=0, w=Math.min(50, Math.abs(v)/maxBp*50);
    const col=up?'var(--red)':'var(--green)';
    return `<div class="flex items-center gap-2 py-1">
      <span class="mono text-xs" style="width:150px;color:var(--text-secondary)">${FLAG[r.name]||''} ${cap(r.name)}</span>
      <div style="flex:1;position:relative;height:14px">
        <div style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--border-soft)"></div>
        <div style="position:absolute;top:2px;bottom:2px;${up?`left:50%`:`right:50%`};width:${w}%;background:${col};opacity:.85;border-radius:2px"></div>
      </div>
      <span class="mono text-xs" style="width:120px;text-align:right;color:${col}">${v>0?'+':''}${fmt(v,0)}bp 10Y</span>
    </div>`;
  };
  el.innerHTML =
    `<div class="eyebrow mb-1" style="color:var(--purple)">ECB stress gauges · true 12-month history</div>` +
    pctRows.map(bar).join('') +
    (proxy.length ? `<div class="eyebrow mt-3 mb-1" style="color:var(--blue)">Bond-desk sovereigns · 10Y-yield Δ12m proxy</div>` + proxy.map(pbar).join('') : '');
}

