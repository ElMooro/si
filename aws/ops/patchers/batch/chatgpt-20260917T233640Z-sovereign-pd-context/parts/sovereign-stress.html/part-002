function renderGSSIStrip(g){
  const rows=(g.series_weekly||[]).filter(r=>r.c!=null||r.b!=null);
  const svg=document.getElementById('gssi-strip');
  if(rows.length<20){ svg.innerHTML=''; return; }
  const W=1400,H=56,padL=52,padR=20,n=rows.length;
  const px=i=>padL+(i/(n-1))*(W-padL-padR);
  let comA=`M ${px(0)} ${H-4-((rows[0].c||0)*44)}`;
  for(let i=1;i<n;i++) comA+=` L ${px(i).toFixed(1)} ${(H-4-((rows[i].c||0)*44)).toFixed(1)}`;
  const comArea=comA+` L ${px(n-1)} ${H-4} L ${px(0)} ${H-4} Z`;
  let bars='';
  const bw=Math.max(0.8,(W-padL-padR)/n*0.7);
  for(let i=0;i<n;i++){ const b=rows[i].b||0; if(b<=0) continue;
    const h=(b/100)*44; bars+=`<rect x="${(px(i)-bw/2).toFixed(1)}" y="${(H-4-h).toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" fill="var(--red)" opacity="0.55"/>`; }
  svg.innerHTML=`<line x1="${padL}" y1="${H-4}" x2="${W-padR}" y2="${H-4}" stroke="var(--border-soft)"/>
    <text x="${padL-6}" y="12" fill="var(--text-muted)" font-size="9" text-anchor="end" font-family="JetBrains Mono">1.0</text>
    <path d="${comArea}" fill="var(--amber)" opacity="0.18"/>
    <path d="${comA}" fill="none" stroke="var(--amber)" stroke-width="1.1" opacity="0.9"/>
    ${bars}`;
}

function renderYoY(d){
