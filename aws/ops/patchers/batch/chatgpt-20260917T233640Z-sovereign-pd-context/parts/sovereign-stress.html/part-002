const FLAG = {switzerland:'🇨🇭',turkey:'🇹🇷',argentina:'🇦🇷',sweden:'🇸🇪',japan:'🇯🇵',mexico:'🇲🇽',canada:'🇨🇦',australia:'🇦🇺',ireland:'🇮🇪',belgium:'🇧🇪',united_kingdom:'🇬🇧',netherlands:'🇳🇱',chile:'🇨🇱',peru:'🇵🇪',south_korea:'🇰🇷',singapore:'🇸🇬',hong_kong:'🇭🇰',taiwan:'🇹🇼',germany:'🇩🇪',france:'🇫🇷',italy:'🇮🇹',spain:'🇪🇸',greece:'🇬🇷',portugal:'🇵🇹',finland:'🇫🇮'};
function sovSpark(rows, name){
  const vs=[]; (rows||[]).slice(-60).forEach(r=>{const c=((r.countries||{})[name])||{}; const v=c.s!=null?c.s:c.comp; if(v!=null) vs.push(v);});
  if (vs.length<5) return '';
  const mn=Math.min(...vs), mx=Math.max(...vs), rg=(mx-mn)||1, n=vs.length;
  let dd=`M 1 ${(20-((vs[0]-mn)/rg)*16).toFixed(1)}`;
  for(let i=1;i<n;i++) dd+=` L ${((i/(n-1))*66+1).toFixed(1)} ${(20-((vs[i]-mn)/rg)*16).toFixed(1)}`;
  const col=stressColor(vs[n-1]);
  return `<svg width="68" height="22" viewBox="0 0 68 22"><path d="${dd}" fill="none" stroke="${col}" stroke-width="1.2" opacity="0.85"/><circle cx="${((n-1)/(n-1))*66+1}" cy="${(20-((vs[n-1]-mn)/rg)*16).toFixed(1)}" r="1.8" fill="${col}"/></svg>`;
}
