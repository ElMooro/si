<script>
const fmt = (n,d=1) => (n===null||n===undefined||isNaN(n)) ? '—' : Number(n).toFixed(d);
const cap = s => (s||'').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
const stressColor = v => v>=60?'var(--red)':v>=40?'var(--amber)':'var(--green)';
const statusColor = s => ({CRISIS:'var(--red)',STRESS:'var(--red)',ELEVATED:'var(--amber)',HIGH:'var(--amber)',NORMAL:'var(--green)',CALM:'var(--green)',LOW:'var(--green)'}[s]||'var(--text-secondary)');
const pctToStress = p => (p===null||p===undefined)?null:p; // percentile already 0-100

function render(d) {
  if (!d || !d.ok) { document.getElementById('updated').textContent='load error'; }
  document.getElementById('updated').textContent = 'updated ' + new Date(d.generated_at).toLocaleString();
  if (d.headline) document.getElementById('headline').textContent = d.headline;

  const es = d.europe_stress || {};
  const publicationAge=Date.now()-Date.parse(d.generated_at);
  if(!['fresh','incomplete'].includes(d.quality?.status)||!Number.isFinite(publicationAge)||publicationAge< -300000||publicationAge>72*3600000){es.score_0_100=null;es.regime='UNAVAILABLE';es.worst_country=null;d.most_stressed_sovereign=null;}
  const scoreEl = document.getElementById('kpi-score');
  scoreEl.textContent = fmt(es.score_0_100,0); scoreEl.style.color = statusColor(es.regime);
  document.getElementById('kpi-regime').innerHTML = `<span class="badge" style="border:1px solid ${statusColor(es.regime)};color:${statusColor(es.regime)}">${es.regime||'—'}</span>`;
  document.getElementById('kpi-worst').textContent = cap(es.worst_country || '—');

  const eaCiss = (d.systemic_stress_ciss||{}).euro_area || {};
  document.getElementById('kpi-ciss').textContent = fmt(eaCiss.level,3);
  document.getElementById('kpi-ciss-pct').textContent = eaCiss.percentile_3y!=null ? `${fmt(eaCiss.percentile_3y,0)}th pct · ${eaCiss.status||''}` : '—';

  // SovCISS by country (sorted by percentile desc)
  const sov = d.sovereign_stress_sovciss || {};
  const sovRows = Object.entries(sov)
    .filter(([k])=>k!=='euro_area')
    .sort((a,b)=>(b[1].percentile_5y??-1)-(a[1].percentile_5y??-1));
  document.getElementById('sovciss-list').innerHTML = sovRows.map(([name,c])=>{
    const p = c.quality?.status==='fresh' && publicationAge<=72*3600000 ? c.percentile_5y : null;
    return `<div class="row">
      <div><div class="text-sm font-medium">${cap(name)}</div>
        <div class="text-[10px] text-[var(--text-muted)] mono">SovCISS ${fmt(c.level,3)} · ${c.as_of||''}</div></div>
      <div class="bar-track"><div class="bar-fill" style="width:${p??0}%;background:${stressColor(p)}"></div></div>
      <div class="mono text-sm" style="color:${stressColor(p)};min-width:42px;text-align:right">${fmt(p,0)}p</div>
      <div><span class="badge" style="border:1px solid ${statusColor(c.status)};color:${statusColor(c.status)}">${c.status||''}</span></div>
    </div>`;
  }).join('') || '<div class="text-xs text-[var(--text-muted)]">no SovCISS data</div>';

  // Composite country stress scores
  const cs = d.country_stress_scores || {};
  const csRows = Object.entries(cs).sort((a,b)=>b[1]-a[1]);
  document.getElementById('country-list').innerHTML = csRows.map(([name,score])=>`
    <div class="row" style="grid-template-columns:1.3fr 3fr auto">
      <div class="text-sm font-medium">${cap(name)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${score}%;background:${stressColor(score)}"></div></div>
      <div class="mono text-sm" style="color:${stressColor(score)};min-width:34px;text-align:right">${fmt(score,0)}</div>
    </div>`).join('') || '<div class="text-xs text-[var(--text-muted)]">no country scores</div>';

  // Asia-Pacific sovereigns
  const asia = d.asia_sovereigns || {};
  const asiaRows = Object.entries(asia);
  document.getElementById('asia-list').innerHTML = asiaRows.map(([name,c])=>{
    if (c.data_unavailable) {
      return `<div class="row" style="grid-template-columns:1.3fr 3fr auto">
        <div class="text-sm font-medium">${cap(name)}</div>
        <div class="text-xs text-[var(--text-muted)]">${c.note ? 'no sovereign-yield feed — equity proxy only' : 'data unavailable'}</div>
        <div><span class="badge" style="border:1px solid var(--text-muted);color:var(--text-muted)">N/A</span></div>
      </div>`;
    }
    const s = c.stress_0_100||0;
    return `<div class="row">
      <div><div class="text-sm font-medium">${cap(name)} ${c.rating?`<span class="badge" style="border:1px solid var(--blue);color:var(--blue);margin-left:4px">${c.rating}</span>`:''}</div>
        <div class="text-[10px] text-[var(--text-muted)] mono">10Y ${fmt(c.sovereign_10y_yield_pct,2)}% · CDS ${c.cds_bp!=null?fmt(c.cds_bp,0)+'bp':'—'} · spread ${c.spread_vs_bund_bp!=null?(c.spread_vs_bund_bp>=0?'+':'')+fmt(c.spread_vs_bund_bp,0)+'bp':'—'} · ${c.as_of||''}</div></div>
      <div class="bar-track"><div class="bar-fill" style="width:${s}%;background:${stressColor(s)}"></div></div>
      <div class="mono text-sm" style="color:${stressColor(s)};min-width:34px;text-align:right">${fmt(s,0)}</div>
      <div><span class="badge" style="border:1px solid ${statusColor(c.status)};color:${statusColor(c.status)}">${c.status||''}</span></div>
    </div>`;
  }).join('') || '<div class="text-xs text-[var(--text-muted)]">no Asia data</div>';

  // CISS by region
  const ciss = d.systemic_stress_ciss || {};
  const cissRows = Object.entries(ciss).sort((a,b)=>(b[1].percentile_3y||0)-(a[1].percentile_3y||0));
  document.getElementById('ciss-list').innerHTML = cissRows.map(([name,c])=>{
    const p = c.percentile_3y||0;
    return `<div class="row">
      <div><div class="text-sm font-medium">${cap(name)}</div>
        <div class="text-[10px] text-[var(--text-muted)] mono">CISS ${fmt(c.level,3)} · Δ1m ${c.change_1m>=0?'+':''}${fmt(c.change_1m,3)}</div></div>
      <div class="bar-track"><div class="bar-fill" style="width:${p??0}%;background:${stressColor(p)}"></div></div>
      <div class="mono text-sm" style="color:${stressColor(p)};min-width:42px;text-align:right">${fmt(p,0)}p</div>
      <div><span class="badge" style="border:1px solid ${statusColor(c.status)};color:${statusColor(c.status)}">${c.status||''}</span></div>
    </div>`;
  }).join('') || '<div class="text-xs text-[var(--text-muted)]">no CISS data</div>';

  // Real economy: unemployment + industrial production merged per country
  const un = d.unemployment || {}, ip = d.industrial_production || {};
  const countries = [...new Set([...Object.keys(un), ...Object.keys(ip)])].filter(c=>c!=='eu_27'&&c!=='euro_area');
  document.getElementById('econ-list').innerHTML = countries.map(c=>{
    const u = un[c]||{}, i = ip[c]||{};
    const uColor = (u.rate_pct||0)>=8?'var(--red)':(u.rate_pct||0)>=6?'var(--amber)':'var(--green)';
    const iColor = (i.yoy_pct||0)<0?'var(--red)':(i.yoy_pct||0)<1?'var(--amber)':'var(--green)';
    return `<div class="row" style="grid-template-columns:1.3fr 1fr 1fr">
      <div class="text-sm font-medium">${cap(c)}</div>
      <div class="mono text-xs">unemp <span style="color:${uColor}">${fmt(u.rate_pct,1)}%</span> <span class="text-[var(--text-muted)]">${u.change_12m_pp>=0?'+':''}${fmt(u.change_12m_pp,1)}pp</span></div>
      <div class="mono text-xs">ind.prod <span style="color:${iColor}">${i.yoy_pct>=0?'+':''}${fmt(i.yoy_pct,1)}%</span> <span class="text-[var(--text-muted)]">YoY</span></div>
    </div>`;
  }).join('') || '<div class="text-xs text-[var(--text-muted)]">no real-economy data</div>';

  try { renderSovV2(d); } catch(e) { console.error('[sov v2]', e); }
}

const GSSI_ST = { mode:'yoy', range:'all' };
function renderGSSIGauge(kp){
  /* ═══ the barometer (ops 3388) — semicircular dial, needle at GSSI ═══ */
  const v = Math.max(0, Math.min(100, kp.gssi||0));
  const cx=115, cy=105, R=88, r=64;
  const a = t => Math.PI * (1 - t/100);              // 0→π (left), 100→0 (right)
  const P = (rad,t)=>[cx+rad*Math.cos(a(t)), cy-rad*Math.sin(a(t))];
  const arc=(t0,t1,color,op)=>{const [x0,y0]=P(R,t0),[x1,y1]=P(R,t1),[x2,y2]=P(r,t1),[x3,y3]=P(r,t0);
    return `<path d="M ${x0} ${y0} A ${R} ${R} 0 0 1 ${x1} ${y1} L ${x2} ${y2} A ${r} ${r} 0 0 0 ${x3} ${y3} Z" fill="${color}" opacity="${op}"/>`;};
  const bands = [[0,30,'var(--green)',.28,'CALM'],[30,45,'var(--green)',.15,'NORMAL'],[45,60,'var(--amber)',.3,'ELEVATED'],[60,75,'var(--red)',.28,'STRESS'],[75,100,'var(--red)',.5,'CRISIS']];
  let g2 = bands.map(b=>arc(b[0],b[1],b[2],b[3])).join('');
  bands.forEach(b=>{const [lx,ly]=P(R+11,(b[0]+b[1])/2);
    g2+=`<text x="${lx}" y="${ly}" fill="var(--text-muted)" font-size="7.5" text-anchor="middle" font-family="JetBrains Mono">${b[4]}</text>`;});
  const [nx,ny]=P(r-7,v);
  const reg = v>=75?'CRISIS':v>=60?'STRESS':v>=45?'ELEVATED':v>=30?'NORMAL':'CALM';
  const col = stressColor(v);
  g2+=`<line class="gssi-needle" x1="${cx}" y1="${cy}" x2="${nx}" y2="${ny}" stroke="${col}" stroke-width="3" stroke-linecap="round"/>
      <circle cx="${cx}" cy="${cy}" r="5.5" fill="${col}"/>
      <text x="${cx}" y="${cy-24}" fill="${col}" font-size="24" font-weight="800" text-anchor="middle" font-family="JetBrains Mono">${fmt(v,1)}</text>
      <text x="${cx}" y="${cy+18}" fill="${col}" font-size="11" font-weight="700" text-anchor="middle" font-family="JetBrains Mono">${reg}</text>`;
  document.getElementById('gssi-gauge').innerHTML =
    `<svg viewBox="0 0 230 128" style="width:230px;height:128px">${g2}</svg>
     <div class="mono text-[10px] text-[var(--text-muted)] mt-1" style="text-align:center">
       ${fmt(kp.pctile,0)}th pct since 1990 · YoY <span style="color:${(kp.yoy_pct||0)>=0?'var(--red)':'var(--green)'}">${kp.yoy_pct>0?'+':''}${fmt(kp.yoy_pct,1)}%</span><br>
       breadth <span style="color:${(kp.breadth_pct||0)>=25?'var(--red)':'var(--text-secondary)'}">${fmt(kp.breadth_pct,0)}%</span> hot · co-movement <span style="color:${(kp.comove||0)>=0.5?'var(--red)':'var(--text-secondary)'}">${fmt(kp.comove,2)}</span>
     </div>`;
}
function renderGSSI(d){
  const g = d._gssi; if (!g || !g.series_weekly) return;
  const kp = g.latest||{};
  renderGSSIGauge(kp);
  let ctl = document.getElementById('gssi-ctl');
