    ctl.innerHTML = ['all','10y','5y'].map(r=>`<button data-r="${r}" class="px-2 py-1 rounded border" style="border-color:var(--border-soft);color:var(--text-secondary);background:transparent;cursor:pointer">${r.toUpperCase()}</button>`).join('')
      + '<span style="width:12px"></span>'
      + [['yoy','YoY %'],['level','Level']].map(([k,l])=>`<button data-m="${k}" class="px-2 py-1 rounded border" style="border-color:var(--border-soft);color:var(--text-secondary);background:transparent;cursor:pointer">${l}</button>`).join('');
    ctl.dataset.wired='1';
    ctl.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
      if(b.dataset.r)GSSI_ST.range=b.dataset.r; if(b.dataset.m)GSSI_ST.mode=b.dataset.m; renderGSSI(d);});
  }
  ctl.querySelectorAll('button').forEach(b=>{const on=(b.dataset.r===GSSI_ST.range)||(b.dataset.m===GSSI_ST.mode);
    b.style.color=on?'var(--blue)':'var(--text-secondary)'; b.style.borderColor=on?'var(--blue)':'var(--border-soft)';});

  let pts = g.series_weekly.map(p=>({d:p.d, v:GSSI_ST.mode==='yoy'?p.yoy:p.v})).filter(p=>p.v!=null);
  if (GSSI_ST.range!=='all' && pts.length){
    const yrs={'10y':10,'5y':5}[GSSI_ST.range];
    const cut=new Date(pts[pts.length-1].d); cut.setFullYear(cut.getFullYear()-yrs);
    const cs=cut.toISOString().slice(0,10); pts=pts.filter(p=>p.d>=cs);
  }
  const svg=document.getElementById('gssi-chart');
  const W=1400,H=380,padL=52,padR=20,padT=14,padB=40, n=pts.length; if(n<2)return;
  const xs=pts.map(p=>p.d), ys=pts.map(p=>p.v);
  const LV = GSSI_ST.mode==='level';
  let yMin,yMax;
  if(LV){yMin=0;yMax=100;}else{const a=Math.max(Math.abs(Math.min(...ys)),Math.abs(Math.max(...ys)))*1.08||1;yMin=-a;yMax=a;}
  const px=i=>padL+(i/(n-1))*(W-padL-padR), py=v=>padT+(1-(v-yMin)/(yMax-yMin))*(H-padT-padB);
  let line=`M ${px(0)} ${py(ys[0])}`; for(let i=1;i<n;i++) line+=` L ${px(i).toFixed(1)} ${py(ys[i]).toFixed(1)}`;
  const baseY=LV?(H-padB):py(0);
  const area=line+` L ${px(n-1)} ${baseY} L ${px(0)} ${baseY} Z`;
  let grid='',lastYr=null;
  const step = GSSI_ST.range==='all'?5:1;
  for(let i=0;i<n;i++){const yr=xs[i].slice(0,4); if(yr!==lastYr&&(+yr)%step===0){lastYr=yr;
    grid+=`<line x1="${px(i)}" y1="${padT}" x2="${px(i)}" y2="${H-padB}" stroke="var(--border-soft)"/>`;
    grid+=`<text x="${px(i)}" y="${H-padB+15}" fill="var(--text-muted)" font-size="10" text-anchor="middle" font-family="JetBrains Mono">${yr}</text>`;}}
