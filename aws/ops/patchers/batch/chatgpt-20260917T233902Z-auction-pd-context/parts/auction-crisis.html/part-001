@@PART 1/2@@
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Treasury Auction Crisis Detector · AI Edition · JustHodl.AI</title>
<meta name="description" content="AI-augmented US Treasury auction crisis detector · 6 historical-pattern signals + tenor decomposition + forward calendar + historical analog matching + uncalibrated concern scores + Claude-powered narrative">
<style>
:root{
  --bg-base:#07090f; --bg-raised:#0e1320; --bg-sunken:#04050a; --bg-elevated:#131a2a;
  --bg-glow:rgba(0,212,255,0.04); --bg-ai:rgba(167,139,250,0.05);
  --border:rgba(120,145,180,0.12); --border-hover:rgba(120,145,180,0.28); --border-strong:rgba(120,145,180,0.40);
  --fg-1:#e6ecf5; --fg-2:#a8b3c7; --fg-3:#6b7a92; --fg-4:#3a4458;
  --green:#38ffa8; --green-dim:#1b8a5c;
  --amber:#ffb13d; --amber-dim:#8a5e10;
  --red:#ff5c7a; --red-dim:#8a2c44;
  --cyan:#00d4ff; --cyan-dim:#0a6080;
  --violet:#a78bfa; --violet-dim:#5b3fa0;
  --font-mono:'IBM Plex Mono',ui-monospace,monospace;
  --font-sans:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:var(--bg-base);color:var(--fg-1);font-family:var(--font-sans);font-size:13px;line-height:1.5;-webkit-font-smoothing:antialiased}
body{min-height:100vh;background-image:repeating-linear-gradient(0deg,rgba(0,212,255,0.012) 0,rgba(0,212,255,0.012) 1px,transparent 1px,transparent 3px)}
a{color:var(--cyan);text-decoration:none}a:hover{color:var(--fg-1)}
code{font-family:var(--font-mono);font-size:11.5px;color:var(--cyan);background:rgba(0,212,255,0.06);padding:1px 6px;border-radius:3px}

/* ─── Topbar ─── */
.topbar{position:sticky;top:0;z-index:50;background:rgba(7,9,15,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);padding:0 24px;display:flex;align-items:center;height:52px;gap:28px}
.brand{font-family:var(--font-mono);font-weight:700;font-size:14px;letter-spacing:1.5px;color:var(--fg-1);display:flex;align-items:center;gap:8px}
.brand .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);animation:pulse 2.5s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
.brand span{color:var(--cyan);font-weight:500}
.nav-links{display:flex;gap:0;flex:1;overflow-x:auto}
.nav-links a{font-family:var(--font-mono);font-size:11px;font-weight:500;letter-spacing:1px;color:var(--fg-3);text-transform:uppercase;padding:0 14px;height:52px;display:flex;align-items:center;border-bottom:2px solid transparent;white-space:nowrap;transition:all .15s}
.nav-links a:hover{color:var(--fg-1);border-bottom-color:var(--cyan-dim);background:var(--bg-glow)}
.nav-links a.active{color:var(--cyan);border-bottom-color:var(--cyan)}

.container{max-width:1500px;margin:0 auto;padding:24px}
.page-hdr{margin-bottom:28px}
.page-hdr h1{font-family:var(--font-mono);font-size:22px;font-weight:700;letter-spacing:1px;margin-bottom:6px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.page-hdr h1 .ai-tag{font-size:11px;font-weight:600;letter-spacing:2px;background:linear-gradient(90deg,var(--violet),var(--cyan));color:var(--bg-base);padding:4px 10px;border-radius:3px}
.page-hdr p{color:var(--fg-3);font-size:13px;max-width:1080px}
.page-hdr .meta-row{display:flex;gap:16px;margin-top:10px;font-family:var(--font-mono);font-size:11px;color:var(--fg-3);flex-wrap:wrap}

.error-banner{display:none;background:rgba(255,92,122,.08);border:1px solid var(--red-dim);color:var(--red);padding:10px 14px;border-radius:6px;margin-bottom:20px;font-family:var(--font-mono);font-size:12px}

/* ─── Hero: regime + composite + AI executive summary ─── */
.hero-grid{display:grid;grid-template-columns:380px 1fr;gap:20px;margin-bottom:20px}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr}}

.regime-banner{background:linear-gradient(135deg,var(--bg-raised),var(--bg-elevated));border:1px solid var(--border-strong);border-radius:8px;padding:24px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px}
.regime-banner.ACUTE_STRESS{border-color:var(--red);box-shadow:0 0 30px rgba(255,92,122,.18)}
.regime-banner.ELEVATED{border-color:var(--amber);box-shadow:0 0 30px rgba(255,177,61,.16)}
.regime-banner.WATCH{border-color:var(--cyan-dim)}
.regime-banner.CALM{border-color:var(--green-dim)}

.score-circle{width:160px;height:160px;border-radius:50%;background:var(--bg-sunken);border:4px solid var(--green);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:var(--font-mono);position:relative}
.score-circle.ACUTE_STRESS{border-color:var(--red);box-shadow:inset 0 0 30px rgba(255,92,122,.15)}
.score-circle.ELEVATED{border-color:var(--amber);box-shadow:inset 0 0 30px rgba(255,177,61,.15)}
.score-circle.WATCH{border-color:var(--amber-dim);box-shadow:inset 0 0 30px rgba(255,177,61,.10)}
.score-circle .big{font-size:48px;font-weight:700;line-height:1}
.score-circle .sub{font-size:10px;color:var(--fg-3);margin-top:6px;letter-spacing:1.5px;font-weight:500}

.regime-meta{display:flex;flex-direction:column;align-items:center;gap:4px}
.regime-meta h2{font-family:var(--font-mono);font-size:11px;letter-spacing:2px;color:var(--fg-3);font-weight:500}
.regime-meta .signal-text{font-family:var(--font-mono);font-size:22px;font-weight:700;letter-spacing:1.5px;color:var(--green)}
.regime-meta.ACUTE_STRESS .signal-text{color:var(--red)}
.regime-meta.ELEVATED .signal-text{color:var(--amber)}
.regime-meta.WATCH .signal-text{color:var(--amber)}
.regime-meta .desc{font-size:11.5px;color:var(--fg-2);margin-top:6px;line-height:1.5;max-width:280px}

.regime-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%;margin-top:6px}
.regime-stats .stat{background:var(--bg-sunken);border:1px solid var(--border);border-radius:4px;padding:8px;text-align:center}
.regime-stats .stat .v{font-family:var(--font-mono);font-size:16px;font-weight:600;color:var(--fg-1)}
.regime-stats .stat .l{font-size:9.5px;color:var(--fg-3);margin-top:2px;letter-spacing:.5px;text-transform:uppercase}

/* ─── AI Executive Summary card ─── */
.ai-card{background:linear-gradient(135deg,rgba(167,139,250,0.04),var(--bg-raised));border:1px solid var(--violet-dim);border-radius:8px;padding:22px 26px;position:relative;overflow:hidden}
.ai-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(180deg,var(--violet),var(--cyan))}
.ai-card .ai-label{display:flex;align-items:center;gap:8px;margin-bottom:14px}
.ai-card .ai-label .dot{width:6px;height:6px;border-radius:50%;background:var(--violet);box-shadow:0 0 8px var(--violet);animation:pulse 2s ease-in-out infinite}
.ai-card .ai-label .lbl{font-family:var(--font-mono);font-size:10.5px;letter-spacing:2px;color:var(--violet);font-weight:600;text-transform:uppercase}
.ai-card .ai-label .stale{font-family:var(--font-mono);font-size:10px;color:var(--fg-4);margin-left:auto}
.ai-card .ai-title{font-family:var(--font-mono);font-size:13px;font-weight:600;letter-spacing:.5px;color:var(--fg-1);margin-bottom:10px;text-transform:uppercase}
.ai-card .ai-body{font-size:13.5px;line-height:1.6;color:var(--fg-1)}
.ai-card .ai-body strong{color:var(--cyan)}
.ai-card .ai-meta{font-family:var(--font-mono);font-size:10px;color:var(--fg-4);margin-top:14px;display:flex;gap:14px;flex-wrap:wrap}

/* ─── AI Decisive Call strip ─── */
.decisive-call{background:linear-gradient(90deg,rgba(0,212,255,.06),rgba(167,139,250,.03),transparent);border:1px solid var(--cyan-dim);border-radius:8px;padding:18px 24px;margin-bottom:20px;display:flex;align-items:center;gap:20px}
.decisive-call.ACUTE_STRESS{border-color:var(--red);background:linear-gradient(90deg,rgba(255,92,122,.06),rgba(255,177,61,.03),transparent)}
.decisive-call.ELEVATED{border-color:var(--amber)}
.decisive-call .label{font-family:var(--font-mono);font-size:11px;letter-spacing:2px;color:var(--cyan);font-weight:700;text-transform:uppercase;flex-shrink:0}
.decisive-call .text{font-size:14px;line-height:1.5;color:var(--fg-1)}

/* ─── Section header ─── */
.section-hdr{margin:32px 0 12px;display:flex;align-items:baseline;gap:12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.section-hdr h3{font-family:var(--font-mono);font-size:13px;font-weight:600;letter-spacing:1.5px;color:var(--fg-1);text-transform:uppercase}
.section-hdr .sub{font-size:11.5px;color:var(--fg-3)}
.section-hdr .badge{margin-left:auto;font-family:var(--font-mono);font-size:9.5px;letter-spacing:1.5px;padding:3px 8px;border-radius:3px;background:var(--bg-elevated);border:1px solid var(--border);color:var(--fg-3);text-transform:uppercase}
.section-hdr .badge.ai{background:rgba(167,139,250,.1);border-color:var(--violet-dim);color:var(--violet)}

/* ─── AI What Changed card ─── */
.what-changed-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:18px 22px;margin-bottom:20px;line-height:1.6;font-size:13px;color:var(--fg-2)}
.what-changed-card strong{color:var(--cyan)}

/* ─── Tenor decomposition heatmap ─── */
.tenor-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:20px}
.tenor-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:14px 16px;position:relative;transition:all .15s;cursor:default}
.tenor-card:hover{border-color:var(--border-hover);background:var(--bg-elevated)}
.tenor-card .name{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.5px;color:var(--fg-1);margin-bottom:8px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.tenor-card .rank-pill{font-size:9px;padding:2px 6px;border-radius:3px;background:var(--bg-sunken);color:var(--fg-3);border:1px solid var(--border)}
.tenor-card .score-row{display:flex;align-items:baseline;gap:10px;margin-bottom:6px}
.tenor-card .score{font-family:var(--font-mono);font-size:26px;font-weight:700;line-height:1}
.tenor-card .max{font-family:var(--font-mono);font-size:11px;color:var(--fg-3)}
.tenor-card .meta{font-family:var(--font-mono);font-size:10.5px;color:var(--fg-3);margin-bottom:8px}
.tenor-card .meta b{color:var(--fg-2);font-weight:500}
.tenor-card .risk{font-size:11px;color:var(--fg-2);line-height:1.4;font-style:italic;border-top:1px dashed var(--border);padding-top:8px;margin-top:6px}
.tenor-card.stress-0{border-left:3px solid var(--green-dim)}
.tenor-card.stress-0 .score{color:var(--green)}
.tenor-card.stress-1{border-left:3px solid var(--amber-dim)}
.tenor-card.stress-1 .score{color:var(--amber)}
.tenor-card.stress-2{border-left:3px solid var(--red-dim)}
.tenor-card.stress-2 .score{color:var(--red)}
.tenor-card.stress-no-data{border-left:3px solid var(--fg-4);opacity:.6}
.tenor-card.stress-no-data .score{color:var(--fg-3);font-size:16px}

/* ─── Cross-signals strip ─── */
.cross-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:20px}
.cross-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:14px 16px}
.cross-card .nm{font-family:var(--font-mono);font-size:10.5px;letter-spacing:1px;color:var(--fg-3);text-transform:uppercase;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center}
.cross-card .val{font-family:var(--font-mono);font-size:20px;font-weight:600;color:var(--fg-1);margin-bottom:4px}
.cross-card .regime-pill{display:inline-block;font-family:var(--font-mono);font-size:9px;letter-spacing:1.5px;padding:2px 7px;border-radius:3px;font-weight:600}
.regime-pill.CALM,.regime-pill.NORMAL,.regime-pill.STABLE,.regime-pill.ANCHORED{background:rgba(56,255,168,.1);color:var(--green);border:1px solid var(--green-dim)}
.regime-pill.WATCH,.regime-pill.WEAKENING,.regime-pill.FLAT{background:rgba(255,177,61,.1);color:var(--amber);border:1px solid var(--amber-dim)}
.regime-pill.ELEVATED,.regime-pill.UNANCHORED,.regime-pill.STRENGTHENING,.regime-pill.INVERTED{background:rgba(255,92,122,.1);color:var(--red);border:1px solid var(--red-dim)}
.regime-pill.ACUTE,.regime-pill.ACUTE_STRESS{background:var(--red);color:var(--bg-base);border:1px solid var(--red)}
.cross-card .interp{font-size:11px;color:var(--fg-3);margin-top:8px;line-height:1.4}

/* ─── 30-day composite chart ─── */
.chart-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:18px 20px;margin-bottom:20px}
.chart-card svg{width:100%;height:260px}
.chart-card .legend{display:flex;gap:18px;font-family:var(--font-mono);font-size:10.5px;color:var(--fg-3);flex-wrap:wrap;margin-top:10px}
.chart-card .legend .item{display:flex;align-items:center;gap:6px}
.chart-card .legend .item .sw{width:10px;height:10px;border-radius:2px}

/* ─── Historical analog card ─── */
.analog-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:20px 22px;margin-bottom:20px}
.analog-top-match{display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--border)}
.analog-top-match .similarity-circle{width:90px;height:90px;border-radius:50%;background:var(--bg-sunken);border:3px solid var(--violet);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:var(--font-mono)}
.analog-top-match .similarity-circle .big{font-size:24px;font-weight:700;color:var(--violet);line-height:1}
.analog-top-match .similarity-circle .sub{font-size:8.5px;color:var(--fg-3);margin-top:3px;letter-spacing:1px}
.analog-top-match .info .anchor-date{font-family:var(--font-mono);font-size:16px;font-weight:600;color:var(--fg-1);letter-spacing:.5px}
.analog-top-match .info .anchor-regime{display:inline-block;font-family:var(--font-mono);font-size:10px;letter-spacing:1.5px;color:var(--red);background:rgba(255,92,122,.1);border:1px solid var(--red-dim);padding:2px 8px;border-radius:3px;margin-left:10px}
.analog-top-match .info .anchor-context{font-size:12px;color:var(--fg-2);margin-top:8px;line-height:1.5}
.analog-top-match .info .anchor-next{font-size:12.5px;color:var(--fg-1);margin-top:10px;line-height:1.5;padding:10px 12px;background:rgba(167,139,250,.06);border-left:2px solid var(--violet);border-radius:0 4px 4px 0}
.analog-top-match .info .anchor-next strong{color:var(--violet)}

.analog-other-matches{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-bottom:14px}
.analog-other-matches .om{background:var(--bg-sunken);border:1px solid var(--border);border-radius:4px;padding:10px 12px}
.analog-other-matches .om .d{font-family:var(--font-mono);font-size:12px;font-weight:600;color:var(--fg-1)}
.analog-other-matches .om .r{font-family:var(--font-mono);font-size:9.5px;color:var(--fg-3);letter-spacing:1px;margin-top:2px}
.analog-other-matches .om .s{font-family:var(--font-mono);font-size:14px;color:var(--violet);font-weight:600;margin-top:4px}
.analog-other-matches .om .nxt{font-size:11px;color:var(--fg-2);margin-top:4px;line-height:1.4}

.analog-ai-discussion{margin-top:6px;font-size:13px;line-height:1.6;color:var(--fg-1);padding:14px 16px;background:rgba(167,139,250,.04);border-left:3px solid var(--violet);border-radius:0 6px 6px 0}
.analog-ai-discussion .lbl{font-family:var(--font-mono);font-size:10px;letter-spacing:1.5px;color:var(--violet);font-weight:600;margin-bottom:6px;text-transform:uppercase}

/* ─── Forward calendar table ─── */
.forward-table{width:100%;border-collapse:collapse;font-size:12px;background:var(--bg-raised);border-radius:6px;overflow:hidden;border:1px solid var(--border);margin-bottom:20px}
.forward-table th{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:1px;color:var(--fg-3);text-transform:uppercase;padding:10px 12px;text-align:left;background:var(--bg-sunken);border-bottom:1px solid var(--border)}
.forward-table td{padding:10px 12px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:11.5px;color:var(--fg-1)}
.forward-table tbody tr:hover{background:var(--bg-elevated)}
.forward-table tbody tr:last-child td{border-bottom:none}
.forward-table .date-cell{color:var(--cyan);font-weight:500}
.forward-table .term-cell{font-size:11px;color:var(--fg-2)}
.forward-table .size-cell{text-align:right;color:var(--fg-2)}
.forward-table .score-cell{font-weight:700}
.forward-table .score-cell.CALM{color:var(--green)}
.forward-table .score-cell.WATCH{color:var(--amber)}
.forward-table .score-cell.ELEVATED{color:var(--amber)}
.forward-table .score-cell.ACUTE{color:var(--red)}
.forward-table .conf-cell{font-size:10px;color:var(--fg-3)}
.forward-table .conf-cell.HIGH{color:var(--green)}
.forward-table .conf-cell.MEDIUM{color:var(--amber)}
.forward-table .conf-cell.LOW{color:var(--fg-3)}
.forward-table .concession-heavy{color:var(--red);font-weight:700}
.forward-table .concession-mild{color:var(--amber);font-weight:600}
.forward-table .concession-flat{color:var(--fg-2)}
.forward-table .concession-rally{color:var(--cyan)}
.forward-table .concession-strong-rally{color:var(--cyan);font-weight:700}
.forward-table .concession-na{color:var(--fg-4)}

/* ─── Post-issue performance table ─── */
.postissue-table{width:100%;border-collapse:collapse;font-size:12px;background:var(--bg-raised);border-radius:6px;overflow:hidden;border:1px solid var(--border);margin-bottom:20px}
.postissue-table th{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:1px;color:var(--fg-3);text-transform:uppercase;padding:10px 12px;text-align:left;background:var(--bg-sunken);border-bottom:1px solid var(--border)}
.postissue-table th.num{text-align:right}
.postissue-table td{padding:9px 12px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:11.5px;color:var(--fg-1)}
.postissue-table td.num{text-align:right}
.postissue-table tbody tr:hover{background:var(--bg-elevated)}
.postissue-table tbody tr:last-child td{border-bottom:none}
.postissue-table .pi-positive{color:var(--green);font-weight:500}
.postissue-table .pi-negative{color:var(--red);font-weight:500}
.postissue-table .pi-class{font-family:var(--font-mono);font-size:9.5px;letter-spacing:1px;padding:2px 8px;border-radius:3px;font-weight:600}
.postissue-table .pi-strong{background:rgba(56,255,168,.15);color:var(--green);border:1px solid var(--green-dim)}
.postissue-table .pi-firm{background:rgba(56,255,168,.08);color:var(--green);border:1px solid var(--green-dim)}
.postissue-table .pi-flat{background:var(--bg-sunken);color:var(--fg-2);border:1px solid var(--border)}
.postissue-table .pi-soft{background:rgba(255,177,61,.1);color:var(--amber);border:1px solid var(--amber-dim)}
.postissue-table .pi-weak{background:rgba(255,92,122,.15);color:var(--red);border:1px solid var(--red-dim)}
.postissue-table .pi-pending,.postissue-table .pi-pending_5d{background:var(--bg-sunken);color:var(--fg-3);border:1px solid var(--border)}

/* ─── Pre-auction concession call-out ─── */
.concession-callout{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:20px}
.concession-tile{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:14px 16px;position:relative;transition:all .15s}
.concession-tile.HEAVY_CONCESSION{border-left:3px solid var(--red);background:linear-gradient(135deg,rgba(255,92,122,.04),var(--bg-raised))}
.concession-tile.CONCESSION{border-left:3px solid var(--amber);background:linear-gradient(135deg,rgba(255,177,61,.04),var(--bg-raised))}
.concession-tile.STRONG_RALLY{border-left:3px solid var(--cyan);background:linear-gradient(135deg,rgba(0,212,255,.05),var(--bg-raised));box-shadow:0 0 18px rgba(0,212,255,.08)}
.concession-tile.RALLY{border-left:3px solid var(--cyan-dim);background:linear-gradient(135deg,rgba(0,212,255,.03),var(--bg-raised))}
.concession-tile.FLAT{border-left:3px solid var(--fg-4);opacity:.7}
.concession-tile.NO_DATA{border-left:3px solid var(--fg-4);opacity:.5}
.concession-tile .hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;flex-wrap:wrap;gap:6px}
.concession-tile .hd .when{font-family:var(--font-mono);font-size:12.5px;color:var(--fg-1);font-weight:600}
.concession-tile .hd .when .days{color:var(--fg-3);font-weight:400;margin-left:6px;font-size:10.5px}
.concession-tile .hd .regime-pill{font-family:var(--font-mono);font-size:9px;letter-spacing:1.5px;padding:2px 8px;border-radius:3px;font-weight:700}
.concession-tile.HEAVY_CONCESSION .regime-pill{background:rgba(255,92,122,.15);color:var(--red);border:1px solid var(--red-dim)}
.concession-tile.CONCESSION .regime-pill{background:rgba(255,177,61,.15);color:var(--amber);border:1px solid var(--amber-dim)}
.concession-tile.STRONG_RALLY .regime-pill{background:rgba(0,212,255,.15);color:var(--cyan);border:1px solid var(--cyan-dim)}
.concession-tile.RALLY .regime-pill{background:rgba(0,212,255,.08);color:var(--cyan);border:1px solid var(--cyan-dim)}
.concession-tile.FLAT .regime-pill{background:var(--bg-sunken);color:var(--fg-3);border:1px solid var(--border)}
.concession-tile .bp-row{display:flex;align-items:baseline;gap:14px;margin-bottom:8px;font-family:var(--font-mono)}
.concession-tile .bp-row .bp5{font-size:24px;font-weight:700;line-height:1}
.concession-tile .bp-row .bp5.pos{color:var(--red)}
.concession-tile .bp-row .bp5.neg{color:var(--cyan)}
.concession-tile .bp-row .bp5.flat{color:var(--fg-2)}
.concession-tile .bp-row .bp1{font-size:11px;color:var(--fg-3)}
.concession-tile .bp-row .bp1 b{color:var(--fg-1);font-weight:500}
.concession-tile .meta{font-family:var(--font-mono);font-size:10px;color:var(--fg-3);margin-bottom:6px}
.concession-tile .meta b{color:var(--fg-2);font-weight:500}
.concession-tile .interp{font-size:11.5px;color:var(--fg-2);line-height:1.45;border-top:1px dashed var(--border);padding-top:8px;margin-top:6px}
.concession-empty{padding:14px;color:var(--fg-3);font-size:11.5px;text-align:center;background:var(--bg-raised);border:1px solid var(--border);border-radius:6px}

/* ─── AI Scenario Commentary cards ─── */
.forward-pred-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px;margin-bottom:24px}
.forward-pred-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:16px 18px;border-left:3px solid var(--violet-dim)}
.forward-pred-card.CALM{border-left-color:var(--green-dim)}
.forward-pred-card.WATCH{border-left-color:var(--amber-dim)}
.forward-pred-card.ELEVATED{border-left-color:var(--amber)}
.forward-pred-card.ACUTE{border-left-color:var(--red)}
.forward-pred-card .head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px}
.forward-pred-card .head .when{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--fg-1)}
.forward-pred-card .head .when .term{color:var(--fg-3);font-weight:400;margin-left:6px}
.forward-pred-card .head .score-tag{font-family:var(--font-mono);font-size:14px;font-weight:700;padding:3px 9px;border-radius:3px;background:var(--bg-sunken)}
.forward-pred-card .head .score-tag.CALM{color:var(--green)}
.forward-pred-card .head .score-tag.WATCH{color:var(--amber)}
.forward-pred-card .head .score-tag.ELEVATED{color:var(--amber)}
.forward-pred-card .head .score-tag.ACUTE{color:var(--red)}
.forward-pred-card .outcome{font-size:12.5px;color:var(--fg-2);line-height:1.5;margin-bottom:10px}
.forward-pred-card .watch{font-size:11.5px;color:var(--fg-2);line-height:1.5;padding:8px 10px;background:rgba(255,177,61,.04);border-left:2px solid var(--amber-dim);border-radius:0 3px 3px 0}
.forward-pred-card .watch strong{color:var(--amber)}

/* ─── Tail risk bars ─── */
.tail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:18px}
.tail-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:16px 18px}
.tail-card .nm{font-family:var(--font-mono);font-size:11px;letter-spacing:1px;color:var(--fg-2);text-transform:uppercase;margin-bottom:10px;font-weight:500}
.tail-card .bar-wrap{height:10px;background:var(--bg-sunken);border-radius:5px;overflow:hidden;margin-bottom:8px;position:relative}
.tail-card .bar{height:100%;background:linear-gradient(90deg,var(--green),var(--amber),var(--red));border-radius:5px;transition:width .5s ease}
.tail-card .pct{font-family:var(--font-mono);font-size:24px;font-weight:700;color:var(--fg-1);line-height:1}
.tail-card .pct .unit{font-size:14px;color:var(--fg-3);font-weight:400}
.tail-card .interp{font-size:11.5px;color:var(--fg-3);margin-top:8px;line-height:1.4}
.tail-card .drivers{font-family:var(--font-mono);font-size:10px;color:var(--fg-4);margin-top:6px;display:flex;flex-wrap:wrap;gap:8px}
.tail-card .drivers span{padding:2px 6px;background:var(--bg-sunken);border-radius:3px;border:1px solid var(--border)}

.tail-ai-card{background:rgba(167,139,250,0.04);border:1px solid var(--violet-dim);border-left:3px solid var(--violet);border-radius:6px;padding:16px 20px;margin-bottom:20px;font-size:13px;line-height:1.6;color:var(--fg-1)}
.tail-ai-card .lbl{font-family:var(--font-mono);font-size:10px;letter-spacing:1.5px;color:var(--violet);font-weight:600;margin-bottom:8px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.tail-ai-card .lbl .dot{width:5px;height:5px;border-radius:50%;background:var(--violet);box-shadow:0 0 6px var(--violet)}
.tail-ai-card strong{color:var(--cyan)}

/* ─── Triggers ─── */
.trigger-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px;margin-bottom:16px}
.trigger-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:6px;padding:14px 16px}
.trigger-card.monitoring{border-left:3px solid var(--green-dim)}
.trigger-card.tactical{border-left:3px solid var(--amber)}
@@END 1@@
