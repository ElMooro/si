def _api_url(fund, ymd=None):
    match = re.search(r"/products/(\d+)/", fund.get("url") or "")
    if not match:
        return None
    uk = "/uk/" in (fund.get("url") or "")
    url = _API % ("uk-ishares" if uk else "us-ishares", "en_GB" if uk else "en_US", match.group(1))
    if ymd:
        url += "&asOfDate=" + ymd
    return url


def parse_api(payload, fund):
    """BlackRock product-data holdings. Identifiers stay inside this process."""
    try:
        pts = payload["componentsByNameMap"]["holdings"]["containersByNameMap"]["all"]["dataPointsByNameMap"]
    except Exception:
        return [], None, []

    def col(name):
        value = (pts.get(name) or {}).get("value")
        return value if isinstance(value, list) else []

    names = col("issueName")
    as_of = _yyyymmdd((pts.get("asOfDate") or {}).get("value"))
    dates = []
    for raw in col("dateList"):
        iso = _yyyymmdd(raw)
        if iso and iso not in dates:
            dates.append(iso)
    if not names:
        return [], as_of, dates

    def at(name, index):
        seq = col(name)
        return seq[index] if index < len(seq) else None

    rows = []
    for index in range(len(names)):
        modified = _num(at("modifiedDuration", index))
        effective = _num(at("duration", index))
        mapped = {
            "issuer": at("issueName", index),
            "sector": at("sectorName", index),
            "asset": at("assetClass", index),
            "maturity": _yyyymmdd(at("maturityDate", index)),
            "coupon": at("couponRate", index),
            "ytm": at("yieldToMaturity", index),
            "ytw": at("yieldToWorst", index),
            "demand": at("marketValue", index),
            "price": at("unitPrice", index),
            "dur": modified if modified is not None else effective,
            "isin": at("isin", index),
            "issued": _yyyymmdd(at("issueDate", index)),
            "ccy": at("marketCurrencyCode", index) or at("currencyCode", index),
            "country": at("countryOfRisk", index),
        }
        row = _row_from(mapped, fund)
        if row:
            rows.append(row)
    return rows, as_of, dates


def _attach_prior(rows, prior_rows, prior_asof):
    """Join the previous file by ISIN. A loaded file that lacks the bond is a real zero, not a blank."""
    index = {}
    for old in prior_rows:
        isin = old.get("isin")
        if isin and isin not in index:
            index[isin] = old
    for row in rows:
        if row.get("_left") or not row.get("isin"):
            continue
        row["prior_file"] = prior_asof
        old = index.get(row["isin"])
        if not old:
            row["prior_demand"] = 0
            row["prior_asof"] = prior_asof
            continue
        if old.get("price") is not None:
            row["prior_price"] = old["price"]
        rate = old.get("ytw") if old.get("ytw") is not None else old.get("ytm")
        if rate is not None:
            row["prior_rate"] = rate
        if old.get("demand") is not None:
            row["prior_demand"] = old["demand"]
        row["prior_asof"] = prior_asof


def _attach_ytd(rows, prior_rows, prior_asof):
    """Longer window: the earliest earlier date that same feed lists, usually year-end."""
    index = {}
    for old in prior_rows:
        isin = old.get("isin")
        if isin and isin not in index:
            index[isin] = old
    for row in rows:
        if row.get("_left") or not row.get("isin"):
            continue
        old = index.get(row["isin"])
        if not old:
            continue
        if old.get("price") is not None:
            row["prior_price_y"] = old["price"]
        rate = old.get("ytw") if old.get("ytw") is not None else old.get("ytm")
        if rate is not None:
            row["prior_rate_y"] = rate
        row["prior_asof_y"] = prior_asof


def _exited(rows, prior_rows, prior_asof):
    """Bonds the previous file held that this file does not. Last print only — not a live price."""
    seen = {row.get("isin") for row in rows if row.get("isin")}
    out = []
    for old in prior_rows:
        isin = old.get("isin")
        if not isin or isin in seen or not old.get("demand"):
            continue
        seen.add(isin)
        rate = old.get("ytw") if old.get("ytw") is not None else old.get("ytm")
        out.append({
            "issuer": old.get("issuer"),
            "sector": old.get("sector") or "",
            "country": old.get("country") or "",
            "ccy": old.get("ccy") or "",
            "coupon": old.get("coupon"),
            "maturity": old.get("maturity"),
            "ytm": None,
            "ytw": None,
            "price": None,
            "demand": None,
            "dur": old.get("dur"),
            "isin": isin,
            "issued": old.get("issued"),
            "book": old.get("book"),
            "fund": old.get("fund"),
            "prior_price": old.get("price"),
            "prior_rate": rate,
            "prior_demand": old.get("demand"),
            "prior_asof": prior_asof,
            "prior_file": prior_asof,
            "_left": True,
        })
    return out


def _load_dated(fund, get_bytes, ymd):
    blob = get_bytes(_api_url(fund, ymd))
    if not blob or blob[:1] not in (b"{", b"["):
        return None
    rows, got, _dates = parse_api(json.loads(blob.decode("utf-8")), fund)
    if not rows or not got:
        return None
    return rows, got


def _load_api(fund, get_bytes):
    url = _api_url(fund)
    if not url:
        return None
    blob = get_bytes(url)
    if not blob or blob[:1] not in (b"{", b"["):
        return None
    rows, as_of, dates = parse_api(json.loads(blob.decode("utf-8")), fund)
    if not rows:
        return None
    priors = [day for day in dates if as_of and day < as_of]
    prior_asof = max(priors) if priors else None
    older = [day for day in priors if prior_asof and day < prior_asof]
    ytd_asof = min(older) if older else None
    if prior_asof:
        try:
            loaded = _load_dated(fund, get_bytes, prior_asof.replace("-", ""))
            if loaded and loaded[1] != as_of:
                prows, got = loaded
                _attach_prior(rows, prows, got)
                rows.extend(_exited(rows, prows, got))
        except Exception:
            pass
    if ytd_asof:
        try:
            loaded = _load_dated(fund, get_bytes, ytd_asof.replace("-", ""))
            if loaded and loaded[1] != as_of:
                _attach_ytd(rows, loaded[0], loaded[1])
        except Exception:
            pass
    return fund, rows, "api", as_of


def load_fund(fund, get_bytes):
    """Latest holdings, plus the previous date the same feed lists (usually month-end)."""
    if fund.get("kind") == "ssga":
        try:
            blob = get_bytes(fund["url"])
        except Exception as exc:
            return fund, [], type(exc).__name__, None
        try:
            rows, as_of = parse_ssga(blob, fund)
        except Exception as exc:
            return fund, [], "parse %s" % type(exc).__name__, None
        return fund, rows, "live" if rows else "empty", as_of
    loaded = None
    try:
        loaded = _load_api(fund, get_bytes)
    except Exception:
        loaded = None
    if loaded and loaded[1]:
        return loaded
    try:
        blob = get_bytes(fund["url"])
        rows, as_of = parse_ishares(blob.decode("utf-8", "replace"), fund)
    except Exception as exc:
        return fund, [], type(exc).__name__, None
    return fund, rows, "csv" if rows else "empty", as_of


