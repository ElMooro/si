        for part in parts:
            if part.get("_left"):
                if part.get("prior_demand") is None:
                    continue
                flow = True
                flow_prior += part["prior_demand"]
                continue
            if not part.get("prior_asof") or part.get("prior_demand") is None:
                continue
            flow = True
            flow_now += part.get("demand") or 0
            flow_prior += part["prior_demand"]
        ddm = round(flow_now - flow_prior, 0) if flow else None
