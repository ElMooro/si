            up = tb["reversal"] == "REVERSAL_UP"
            liq_dir = ("EASING" if (up and pol > 0)
                       or (not up and pol < 0) else "TIGHTENING")
        row = {"symbol": sym, "name": name, "resolved": True,
                "last": round(last, 4),
                "dod_pct": round(dod, 2) if dod is not None else None,
                "chg_str": chg_str,
